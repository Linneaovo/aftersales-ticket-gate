# 单仓自立演示档（无 enterprise-rag :8001）
# 用法：copy .env.standalone .env → start_copilot.cmd + start_ui.cmd
# 或：start_standalone.cmd

RAG_BASE_URL=http://127.0.0.1:8001
DEFAULT_KB=demo-kb
API_KEY=demo-technician
AGENT_HOST=127.0.0.1
AGENT_PORT=8002
MAX_ITERATIONS=8
AUTO_SUBMIT=0
HITL_REQUIRED_ON_CONFLICT=1
CHECKPOINT_DB_PATH=data/checkpoints.db
PERSIST_MODE=slim
COPILOT_BASE_URL=http://127.0.0.1:8002

COPILOT_RUNTIME_MODE=standalone
DEMO_OFFLINE=1
RAG_AUTO_FALLBACK=0
REQUIRE_LIVE=0
BLOCK_RUNS_WHEN_NOT_LIVE=0
SUBMIT_DESTINATION=file_outbox
# 模式错配 / 多 worker → 启动直接退出
STRICT_STARTUP=1
UVICORN_WORKERS=1
# 可选伪 WMS：START_MOCK_WMS=1 时 start_standalone.cmd 会起 :8011；默认关（JsonPartsLedger）
START_MOCK_WMS=0
# PARTS_LEDGER_URL=http://127.0.0.1:8011

REQUIRE_KNOWN_API_KEY=1
CORS_ORIGINS=http://127.0.0.1:8502,http://localhost:8502
RAG_REACHABILITY_TTL_S=30
ENGINE_STRICT=1
EXPOSE_METRICS=1
EXPOSE_DEMO_HINTS=1
ALLOW_DEMO_PARTS_HINTS=0
ALLOW_ANSWER_TOKEN_HINTS=0
ENABLE_WEATHER_POL=0
CONTRACT_VALIDATE=strict
INTENT_CONFIDENCE_THRESHOLD=0.5
HITL_WAIT_TTL_HOURS=72
