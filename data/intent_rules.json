  "urgent_tokens": ["紧急", "抢修", "停机", "无法作业", "首响"],
  "warranty_tokens": ["在保", "质保内", "过保", "质保期"],
  "model_pattern": "\\b(SY215C?|SR155|SY215|SWM220)\\b",
  "fault_code_pattern": "(?<![A-Za-z0-9])([EHC]\\d{3})(?!\\d)",
  "intent_confidence_threshold": 0.5,
  "fault_dispatch_score_weights": {
    "_doc": "启发式信号加权（非校准概率）。confidence=各信号权重之和 capped 1.0，仅作 POL-INTENT-01 低置信强制人确触发器；改权重后请跑 scripts/intent_weight_sensitivity.py。",
    "fault_code": 0.35,
    "model": 0.25,
    "action": 0.25,
    "symptom": 0.15,
    "dispatch_token": 0.10,
    "weak_action": 0.10,
    "intake_phrase": 0.15,
    "station_or_jobsite": 0.08,
    "intake_phrase_any": ["报修", "开单"]
  },
  "equipment_context_tokens": [
    "泵车", "挖机", "起重机", "履带", "转台", "动臂", "大臂", "液压", "车子", "抬臂", "机子", "胳膊", "斗杆", "设备"
  ],
  "fault_phrase_tokens": ["有问题", "出问题了", "催得紧", "抬臂慢", "动作慢"],
  "master_visit_tokens": ["过来", "上门", "一趟", "看看"],
  "help_appeal_tokens": ["你们", "帮忙"],
  "master_mention_tokens": ["师傅"],
  "intent_priority_rules": [
    {"rule_id": "INJ-01", "intent": "injection", "match": "injection_tokens", "confidence": 1.0, "signal": "injection"},
    {"rule_id": "CHAT-01", "intent": "chitchat", "match": "chat_tokens", "confidence": 1.0, "signal": "chitchat"},
    {"rule_id": "ACL-01", "intent": "acl_probe", "match": "acl_probe_tokens", "confidence": 1.0, "signal": "acl_probe"}
  ],
  "fault_dispatch_rules": [
    {
      "rule_id": "FD-01",
      "note": "故障码 + 动作/症状/派工弱信号",
      "all": ["codes"],
      "any": ["has_action", "has_symptom", "has_dispatch", "has_weak_action"]
    },
    {
      "rule_id": "FD-02",
      "note": "机型 + 动作/症状/派工弱信号",
      "all": ["has_model"],
      "any": ["has_action", "has_symptom", "has_dispatch", "has_weak_action"]
    },
    {
      "rule_id": "FD-03",
      "note": "强动作 + 症状",
      "all": ["has_action", "has_symptom"]
    },
    {
      "rule_id": "FD-04",
      "note": "症状 + 弱动作/派工/求助语气",
      "all": ["has_symptom"],
      "any": ["has_weak_action", "has_dispatch", "has_help_appeal"]
    },
    {
      "rule_id": "FD-05",
      "note": "派工词 + 设备语境",
      "all": ["has_dispatch", "has_equipment_ctx"]
    },
    {
      "rule_id": "FD-06",
      "note": "师傅 + 上门/过来类",
      "all": ["has_master_mention", "has_master_visit"]
    },
    {
      "rule_id": "FD-07",
      "note": "设备语境 + 故障短语 + 弱动作/求助/站工地",
      "all": ["has_equipment_ctx", "has_fault_phrase"],
      "any": ["has_weak_action", "has_help_appeal", "has_geo_ctx"]
    },
    {
      "rule_id": "FD-08",
      "note": "症状 + 站/工地/客户语境",
      "all": ["has_symptom", "has_geo_ctx"]
    },
    {
      "rule_id": "FD-09",
      "note": "设备语境 + 弱动作口语",
      "all": ["has_equipment_ctx", "has_weak_action"]
    },
    {
      "rule_id": "FD-10",
      "note": "症状 + 设备指称词",
      "all": ["has_symptom", "has_equipment_token"]
    },
    {
      "rule_id": "FD-11",
      "note": "故障码 + 症状",
      "all": ["codes", "has_symptom"]
    }
  ],
  "post_fault_rules": [
    {
      "rule_id": "KO-01",
      "intent": "knowledge_only",
      "match": "knowledge_query_tokens",
      "exclude_any": ["哪个为准", "不一致", "冲突", "新旧制度"],
      "confidence": 1.0,
      "signal": "knowledge_query"
    },
    {
      "rule_id": "CR-01",
      "intent": "conflict_review",
      "match": "conflict_tokens",
      "confidence": 1.0,
      "signal": "conflict"
    }
  ],
  "fallback_rule": {
    "rule_id": "KO-FALLBACK",
    "intent": "knowledge_only",
    "confidence": 0.6,
    "signal": "fallback_knowledge"
  }
}
