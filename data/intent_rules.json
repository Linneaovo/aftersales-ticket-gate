  "injection_tokens": ["忽略以上", "忽略之前", "jailbreak", "系统提示", "prompt injection", "绕过限制", "hidden prompt", "开发者模式"],
  "acl_probe_tokens": ["薪酬", "工资", "合同金额", "采购合同", "保密制度", "年终奖", "合同价款"],
  "conflict_tokens": ["质保", "质保期", "哪个为准", "新旧制度", "冲突", "不一致", "打架", "听谁的", "对不上", "互相矛盾"],
  "second_visit_tokens": ["二次进站", "再次上门", "再上门", "重复进站", "二次上门", "二进宫"],
  "knowledge_query_tokens": [
    "第几章",
    "是什么意思",
    "什么意思",
