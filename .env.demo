# 答辩/面试演示专用（真连 RAG，禁止静默离线兜底）
RAG_BASE_URL=http://127.0.0.1:8001
DEFAULT_KB=demo-kb
API_KEY=demo-technician
AGENT_HOST=127.0.0.1
AGENT_PORT=8002
MAX_ITERATIONS=8
AUTO_SUBMIT=0
HITL_REQUIRED_ON_CONFLICT=1
CHECKPOINT_DB_PATH=data/checkpoints.db
PERSIST_MODE=slim
COPILOT_BASE_URL=http://127.0.0.1:8002
DEMO_OFFLINE=0
RAG_AUTO_FALLBACK=0
REQUIRE_KNOWN_API_KEY=1
REQUIRE_LIVE=1
BLOCK_RUNS_WHEN_NOT_LIVE=1
CORS_ORIGINS=http://127.0.0.1:8502,http://localhost:8502
RAG_REACHABILITY_TTL_S=30
ENGINE_STRICT=1
EXPOSE_METRICS=1
ALLOW_DEMO_PARTS_HINTS=0
ALLOW_ANSWER_TOKEN_HINTS=0
# 软收敛：雨季门禁默认关（代码保留；深挖时可 ENABLE_WEATHER_POL=1）
ENABLE_WEATHER_POL=0
# 可选：本地伪 WMS（python scripts/mock_parts_wms.py 后取消下一行注释）
# PARTS_LEDGER_URL=http://127.0.0.1:8011
EXPOSE_DEMO_HINTS=1
# E4 L3 / O2：与 RAG A档 COPILOT_SUBMIT_TOKEN 同值；业务 submit 自动带 header
# 联调时 RAG 须经 demo_env 开启 SUBMIT_REQUIRE_COPILOT_TOKEN=1（demo_preflight --require-rag 会检查）
COPILOT_SUBMIT_TOKEN=demo-copilot-submit-shared
# O3：契约热路径 strict|warn|off（缺 grounded 等 → degrade，禁止默填 true）
CONTRACT_VALIDATE=strict
SUBMIT_DESTINATION=rag_mock_inbox
