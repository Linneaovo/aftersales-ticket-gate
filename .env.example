RAG_BASE_URL=http://127.0.0.1:8001
DEFAULT_KB=demo-kb
API_KEY=demo-technician
AGENT_HOST=127.0.0.1
AGENT_PORT=8002
MAX_ITERATIONS=8
AUTO_SUBMIT=0
HITL_REQUIRED_ON_CONFLICT=1
CHECKPOINT_DB_PATH=data/checkpoints.db
PERSIST_MODE=slim
COPILOT_BASE_URL=http://127.0.0.1:8002

# === 三档用法（只保留一份 .env；从对应模板复制）===
# standalone：copy .env.standalone .env（Fixture + file_outbox，无 :8001）
# demo/live：copy .env.demo .env（enterprise-rag + rag_mock_inbox）
# dev：本文件作底稿，按需改 DEMO_OFFLINE / SUBMIT_DESTINATION

# 演示离线：强制 DemoRag，不连 :8001（仅本地无 RAG 时显式开启）
DEMO_OFFLINE=0
# 默认 0：:8001 不可达则失败，禁止静默 DemoRag 冒充联动；日常离线开发可临时改 1
RAG_AUTO_FALLBACK=0
# 默认拒绝 KEY_ROLE_MAP 外 Key（与代码默认一致；勿回退 0）
REQUIRE_KNOWN_API_KEY=1
# RAG 不可达且 fallback=0 时 POST /runs 返回 503（推荐与 .env.demo 一致）
BLOCK_RUNS_WHEN_NOT_LIVE=0
# LangGraph 异常不静默 fallback（容灾须显式 ENGINE_STRICT=0）
ENGINE_STRICT=1
EXPOSE_METRICS=1
# CORS 来源（逗号分隔；* 表示全开放）
CORS_ORIGINS=http://127.0.0.1:8502,http://localhost:8502
# RAG 可达性探测缓存 TTL（秒）
RAG_REACHABILITY_TTL_S=30
# API parts_hints 注入（默认关；主路径走 RAG draft；playbook 直调不受影响）
ALLOW_DEMO_PARTS_HINTS=0
# 从 RAG answer 扫配件词表（默认关，防误触）
ALLOW_ANSWER_TOKEN_HINTS=0
# 雨季/户外门禁（开发默认关；演示天气策略时用 .env.demo 的 ENABLE_WEATHER_POL=1）
ENABLE_WEATHER_POL=0
# SQLite checkpoint 须单 worker；>1 启动 fail-fast
UVICORN_WORKERS=1
# standalone/live 模式错配时启动退出（standalone 模板默认开）
# STRICT_STARTUP=1
# 可选：本地伪 WMS（先 python scripts/mock_parts_wms.py；学生演示级，非主机厂生产库）
# PARTS_LEDGER_URL=http://127.0.0.1:8011
# START_MOCK_WMS=1
# 真连专用：copy .env.demo .env → RAG_AUTO_FALLBACK=0 + REQUIRE_LIVE=1 + BLOCK_RUNS_WHEN_NOT_LIVE=1
# E4 L3 / O2：与 RAG A档 COPILOT_SUBMIT_TOKEN 同值（demo_env 开 SUBMIT_REQUIRE_COPILOT_TOKEN=1）
# COPILOT_SUBMIT_TOKEN=demo-copilot-submit-shared
# O3：契约热路径 strict|warn|off
# CONTRACT_VALIDATE=strict
# 提交终点：rag_mock_inbox（Live 常用）| file_outbox（Standalone 默认见 .env.standalone）
# SUBMIT_DESTINATION=rag_mock_inbox
# 运行模式：standalone | live | ci（空则按 DEMO_OFFLINE / REQUIRE_LIVE 推导）
# COPILOT_RUNTIME_MODE=
# POL-INTENT-01 阈值（与 intent_rules.json 同源；json 优先）
# INTENT_CONFIDENCE_THRESHOLD=0.5
# waiting_hitl 超过 N 小时自动 failed（0=禁用）
# HITL_WAIT_TTL_HOURS=72
# 冲突策略写死 no_arbitration（无 CONFLICT_POLICY 环境变量）
