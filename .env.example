RAG_BASE_URL=http://127.0.0.1:8001
DEFAULT_KB=demo-kb
API_KEY=demo-technician
AGENT_HOST=127.0.0.1
AGENT_PORT=8002
MAX_ITERATIONS=8
AUTO_SUBMIT=0
HITL_REQUIRED_ON_CONFLICT=1
CHECKPOINT_DB_PATH=data/checkpoints.db
PERSIST_MODE=slim
COPILOT_BASE_URL=http://127.0.0.1:8002
# 演示离线：强制 DemoRag，不连 :8001
DEMO_OFFLINE=0
# :8001 不可达时自动切 DemoRag（开发/CI 默认 1；答辩请 copy .env.demo 设为 0）
# 口径：答辩 live 强制真连 RAG；CI/开发可用 DemoRag 替身做回归
RAG_AUTO_FALLBACK=1
# 拒绝 KEY_ROLE_MAP 外的 API Key（答辩 .env.demo 设为 1）
REQUIRE_KNOWN_API_KEY=0
# RAG 不可达且 fallback=0 时 POST /runs 返回 503（答辩 .env.demo 设为 1）
BLOCK_RUNS_WHEN_NOT_LIVE=0
ENGINE_STRICT=0
EXPOSE_METRICS=1
# CORS 来源（逗号分隔；* 表示全开放）
CORS_ORIGINS=http://127.0.0.1:8502,http://localhost:8502
# RAG 可达性探测缓存 TTL（秒）
RAG_REACHABILITY_TTL_S=30
# 答辩专用：copy .env.demo .env → RAG_AUTO_FALLBACK=0 + REQUIRE_KNOWN_API_KEY=1 + BLOCK_RUNS_WHEN_NOT_LIVE=1
